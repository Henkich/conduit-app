# Copy to .env and replace the values: cp .env.example .env
# .env is git-ignored; never commit real secrets.

# PostgreSQL (used by the db container and passed to the backend)
POSTGRES_USER=conduit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=conduit

# Secret for signing JWT tokens (any long random string)
JWT_KEY=change_me_to_a_long_random_string

# Host ports (optional, defaults shown)
FRONTEND_PORT=3000
BACKEND_PORT=3001
